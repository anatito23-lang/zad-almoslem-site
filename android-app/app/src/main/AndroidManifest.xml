    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <uses-permission android:name="android.permission.BIND_QUICK_SETTINGS_TILE" />
    <application android:allowBackup="true" android:label="قلبي اطمأن - زاد المسلم" android:icon="@drawable/ic_launcher_new" android:roundIcon="@drawable/ic_launcher_new" android:usesCleartextTraffic="false" android:theme="@style/AppTheme">
