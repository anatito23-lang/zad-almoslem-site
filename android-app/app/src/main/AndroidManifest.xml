        <activity android:name=".FaithLibraryActivity" android:exported="false" />
        <activity android:name=".DailyWirdActivity" android:exported="false" />
        <activity android:name=".DailyReminderSettingsActivity" android:exported="false" />
        <activity android:name=".MainActivity" android:exported="true" android:configChanges="orientation|screenSize|keyboardHidden">
