<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/next_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="7dp"
    android:paddingBottom="7dp"
    android:background="@drawable/next_prayer_widget_bg">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/next_widget_city"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="مواقيت الصلاة"
            android:textColor="#D5E6DC"
            android:textSize="10sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:gravity="start" />

        <TextView
            android:id="@+id/next_widget_prayer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="الصلاة القادمة: الفجر"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:gravity="start"
            android:paddingTop="3dp" />

        <TextView
            android:id="@+id/next_widget_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="موعدها 04:30"
            android:textColor="#D5E6DC"
            android:textSize="10sp"
            android:maxLines="1"
            android:gravity="start"
            android:paddingTop="2dp" />
    </LinearLayout>

    <View
        android:layout_width="1dp"
        android:layout_height="34dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:background="#668E7C" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="المتبقي"
            android:textColor="#E4CD91"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/next_widget_countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00:00"
            android:textColor="#F1D99A"
            android:textSize="21sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:gravity="center"
            android:paddingTop="2dp" />

        <Chronometer
            android:id="@+id/next_widget_chronometer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:countDown="true"
            android:textColor="#F1D99A"
            android:textSize="21sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:gravity="center"
            android:paddingTop="2dp" />
    </LinearLayout>
</LinearLayout>