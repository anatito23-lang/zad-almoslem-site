<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/next_widget_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center" android:padding="14dp"
    android:background="@drawable/next_prayer_widget_bg">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="۞  زاد المسلم  ۞" android:textColor="#E4CD91"
        android:textSize="12sp" android:textStyle="bold" android:gravity="center" />
    <TextView android:id="@+id/next_widget_city" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="مواقيت الصلاة"
        android:textColor="#D5E6DC" android:textSize="11sp" android:gravity="center"
        android:paddingTop="3dp" />
    <TextView android:id="@+id/next_widget_prayer" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="الصلاة القادمة: الفجر"
        android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold"
        android:gravity="center" android:paddingTop="7dp" />
    <TextView android:id="@+id/next_widget_countdown" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="00:00:00"
        android:textColor="#F1D99A" android:textSize="27sp" android:textStyle="bold"
        android:gravity="center" android:fontFamily="monospace" android:paddingTop="3dp" />
    <Chronometer android:id="@+id/next_widget_chronometer" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:visibility="gone" android:countDown="true"
        android:textColor="#F1D99A" android:textSize="27sp" android:textStyle="bold"
        android:gravity="center" android:fontFamily="monospace" android:paddingTop="3dp" />
    <TextView android:id="@+id/next_widget_time" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="موعدها 04:30"
        android:textColor="#D5E6DC" android:textSize="12sp" android:gravity="center"
        android:paddingTop="4dp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="اضغط لفتح مواقيت الصلاة" android:textColor="#E4CD91"
        android:textSize="10sp" android:gravity="center" android:paddingTop="7dp" />
</LinearLayout>