<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Keep radio streaming hosts explicit; all other cleartext traffic stays blocked. -->
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">quran-radio.org</domain>
        <domain includeSubdomains="false">www.quran-radio.org</domain>
        <domain includeSubdomains="true">quran-radio.com</domain>
    </domain-config>
</network-security-config>
