rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.uid == "5UkeBQyyGGZcICXULT9LUD0S4lt2";
    }

    function isPublished() {
      return resource.data.get('published', false) == true
        || resource.data.get('تم النشر', false) == true
        || resource.data.get('النشر', false) == true;
    }

    // Public content is explicitly allowlisted. All other collections are private by default.
    match /azkar/{documentId} {
      allow read: if isAdmin() || isPublished();
      allow write: if isAdmin();
    }
    match /duas/{documentId} {
      allow read: if isAdmin() || isPublished();
      allow write: if isAdmin();
    }
    match /khutbahs/{documentId} {
      allow read: if isAdmin() || isPublished();
      allow write: if isAdmin();
    }
    match /site_content/{documentId} {
      allow read: if isAdmin() || isPublished();
      allow write: if isAdmin();
    }
    match /app_content/{documentId} {
      allow read: if isAdmin() || isPublished();
      allow write: if isAdmin();
    }
    match /library_books/{documentId} {
      allow read: if isAdmin() || isPublished();
      allow write: if isAdmin();
    }
    match /site_custom_content/{documentId} {
      allow read: if isAdmin() || isPublished();
      allow write: if isAdmin();
    }
    match /waqafat/{documentId} {
      allow get: if documentId == "app_navigation_config"
        || documentId == "custom_tabs_public"
        || (documentId != "custom_tabs_config" && isAdmin())
        || (documentId != "custom_tabs_config" && isPublished());
      allow list: if isAdmin() || isPublished();
      allow create, update, delete: if isAdmin();
    }
    match /site_custom_tabs/{documentId} {
      allow get: if documentId == "site_custom_tabs_public" || isAdmin();
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }
    match /site_settings/{documentId} {
      allow get: if documentId == "website" || isAdmin();
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }
    match /app_audio_assets/{documentId} {
      allow get: if true;
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }
    match /app_admin_config/{documentId} {
      allow read, write: if isAdmin();
    }

    // No catch-all public read rule: unknown and future collections stay private.
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}