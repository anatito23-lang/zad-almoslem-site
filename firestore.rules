rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Published content is readable by app users. Client-side writes are disabled.
    // Admin publishing will be enabled only after authenticated admin identity is configured.
    match /{collection}/{document} {
      allow read: if resource.data.published == true;
      allow create, update, delete: if false;
    }
  }
}
