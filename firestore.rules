rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.uid == "5UkeBQyyGGZcICXULT9LUD0S4lt2";
    }

    // Keep compatibility with content created by older admin versions.
    // Missing publication fields are treated as unpublished.
    function isPublished() {
      return resource.data.get('published', false) == true
        || resource.data.get('تم النشر', false) == true
        || resource.data.get('النشر', false) == true;
    }

    // Full configuration (including hidden tabs) is private.
    match /waqafat/__custom_tabs__ {
      allow read, write: if isAdmin();
    }

    // Only the deliberately public navigation projection is readable by visitors.
    match /waqafat/__custom_tabs_public__ {
      allow get: if true;
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /azkar/{documentId} {
      allow read: if isAdmin() || isPublished();
      allow create, update, delete: if isAdmin();
    }

    match /duas/{documentId} {
      allow read: if isAdmin() || isPublished();
      allow create, update, delete: if isAdmin();
    }

    match /khutbahs/{documentId} {
      allow read: if isAdmin() || isPublished();
      allow create, update, delete: if isAdmin();
    }

    match /waqafat/{documentId} {
      allow read: if isAdmin() || isPublished();
      allow create, update, delete: if isAdmin();
    }

    // Deny access to every collection not explicitly listed above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
