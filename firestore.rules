rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.uid == "5UkeBQyyGGZcICXULT9LUD0S4lt2";
    }

    // Public clients may read published content only.
    // The custom-tabs metadata document contains navigation labels/icons,
    // not drafts or unpublished content, so it is readable but writable only by admin.
    match /waqafat/__custom_tabs__ {
      allow get: if true;
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /azkar/{documentId} {
      allow read: if isAdmin() || resource.data.published == true;
      allow create, update, delete: if isAdmin();
    }

    match /duas/{documentId} {
      allow read: if isAdmin() || resource.data.published == true;
      allow create, update, delete: if isAdmin();
    }

    match /khutbahs/{documentId} {
      allow read: if isAdmin() || resource.data.published == true;
      allow create, update, delete: if isAdmin();
    }

    match /waqafat/{documentId} {
      allow read: if isAdmin() || resource.data.published == true;
      allow create, update, delete: if isAdmin();
    }

    // Default deny: no other collection/document is accessible.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}