rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isPublished() {
      return resource.data.get('published', false) == true
        || resource.data.get('تم النشر', false) == true
        || resource.data.get('النشر', false) == true;
    }
    match /azkar/{document} {
      allow read: if isPublished();
      allow create, update, delete: if false;
    }
    match /duas/{document} {
      allow read: if isPublished();
      allow create, update, delete: if false;
    }
  }
}